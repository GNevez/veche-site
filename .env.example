# Sem esta variável, "Baixar para Windows" baixa o VecheSetup.exe da versão mais recente do GitHub.
# NEXT_PUBLIC_WINDOWS_DOWNLOAD_URL=https://exemplo.com/VecheSetup.exe
# API responsável pelo catálogo, autenticação e uploads para o R2.
# pnpm dev carrega .env.development; pnpm build carrega .env.production.
# Para substituir a API nesta máquina, defina em .env.local:
# NEXT_PUBLIC_API_URL=http://localhost:5006
# Endereço do Veche no navegador (botão "Entrar no Veche").
# NEXT_PUBLIC_WEB_APP_URL=https://app.veche.com.br
